generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  StoreMember[]
}

model Store {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  subdomain          String         @unique
  customDomain       String?        @unique
  templateId         String         @default("moun-journey")
  status             String         @default("draft") // draft | live
  isPrimary          Boolean        @default(false)
  contactEmail       String?
  brandColor         String         @default("#004751")
  tagline            String?
  description        String?
  legalPrivacy       String?
  legalTerms         String?
  legalShipping      String?
  stripeSecretKey    String?
  stripePublishableKey String?
  stripeWebhookSecret String?
  previewImage       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  members            StoreMember[]
  products           Product[]
  categories         Category[]
  customers          Customer[]
  orders             Order[]
  domains            Domain[]
  discounts          Discount[]
  carts              Cart[]
  paymentMethods     PaymentMethod[]
  shipments          Shipment[]
}

model PaymentMethod {
  id        String   @id @default(cuid())
  storeId   String
  type      String // high_risk | crypto | bank_transfer | demo
  name      String
  enabled   Boolean  @default(false)
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  /// JSON config (instructions, email, client id, etc.)
  config    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, type])
}

model Theme {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  previewUrl  String?
  fileUrl     String?
  version     String   @default("1.0")
  source      String   @default("upload") // upload
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StoreMember {
  id      String @id @default(cuid())
  role    String @default("owner") // owner | admin
  userId  String
  storeId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

model Domain {
  id        String   @id @default(cuid())
  hostname  String   @unique
  verified  Boolean  @default(false)
  isPrimary Boolean  @default(false)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([storeId, slug])
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String
  description String?
  imageUrl    String?
  /// Extra product photos as a JSON string array of URLs
  galleryUrls String?
  status      String           @default("active") // active | draft
  storeId     String
  categoryId  String?
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category?        @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([storeId, slug])
}

model ProductVariant {
  id        String     @id @default(cuid())
  label     String
  sku       String?
  price     Float
  compareAt Float?
  stock     Int        @default(100)
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]
}

model Customer {
  id        String   @id @default(cuid())
  email     String
  name      String?
  phone     String?
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders    Order[]
  createdAt DateTime @default(now())

  @@unique([storeId, email])
}

model Order {
  id              String      @id @default(cuid())
  number          String
  status          String      @default("pending") // pending | paid | fulfilled | cancelled | refunded
  email           String
  customerName    String?
  total           Float
  currency        String      @default("EUR")
  stripeSessionId String?
  shippingAddress String?
  storeId         String
  customerId      String?
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?   @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  shipment        Shipment?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([storeId, number])
}

/// Fulfillment / shipping record for an order
model Shipment {
  id             String    @id @default(cuid())
  status         String    @default("unfulfilled") // unfulfilled | preparing | shipped | delivered | cancelled
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  notes          String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  orderId        String    @unique
  storeId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId, status])
}

model OrderItem {
  id        String         @id @default(cuid())
  title     String
  variantLabel String?
  quantity  Int
  unitPrice Float
  orderId   String
  variantId String?
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model Cart {
  id        String     @id @default(cuid())
  token     String     @unique
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  quantity  Int            @default(1)
  cartId    String
  variantId String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Discount {
  id        String   @id @default(cuid())
  code      String
  type      String   // percent | fixed
  value     Float
  active    Boolean  @default(true)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storeId, code])
}

# Single-box reverse proxy.
# HTTP/HTTPS for configured domain names. Direct IP access returns 404.

{
	email {$ACME_EMAIL}

	# Caddy 2.10+ dropped interval/burst here — rate limits are global now.
	on_demand_tls {
		ask http://app:3000/api/internal/domain-check
	}

	servers {
		trusted_proxies static private_ranges
	}
}

# Plain HTTP for real hostnames only — direct IP access is blocked.
:80 {
	@ipHost header_regexp Host ^([0-9]{1,3}\.){3}[0-9]{1,3}(:\d+)?$

	encode zstd gzip

	handle @ipHost {
		respond "Not Found" 404
	}

	handle /api/internal/* {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy app:3000 {
			header_up X-Real-IP {remote_host}
		}
	}
}

# Real hostnames get HTTPS automatically once DNS points here.
https:// {
	tls {
		on_demand
	}

	@ipHost header_regexp Host ^([0-9]{1,3}\.){3}[0-9]{1,3}(:\d+)?$

	encode zstd gzip

	handle @ipHost {
		respond "Not Found" 404
	}

	handle /api/internal/* {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy app:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	log {
		output file /var/log/caddy/single.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

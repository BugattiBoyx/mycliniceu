# Single Hetzner box (CX23 / 4 GB). Copy to deploy/env/single.env
#
# SECURITY: Never commit single.env, paste secrets in chat, or store passwords
# in the repo. Keep secrets only on the server (deploy/env/single.env) or in a
# password manager. Rotate immediately if a credential is exposed.

POSTGRES_USER=mosmo
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=mosmo

# openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_AUTH_SECRET

# Public IP of this server (DNS A record target)
STOREFRONT_IP=37.27.28.78

# Storefront on the apex; admin dashboard on a private subdomain.
# Example: shop at thecliniceu.com, infra at admin.thecliniceu.com
CONTROL_DOMAIN=admin.thecliniceu.com
NEXT_PUBLIC_ROOT_DOMAIN=thecliniceu.com
NEXT_PUBLIC_APP_URL=https://thecliniceu.com
AUTH_URL=https://admin.thecliniceu.com

ACME_EMAIL=ops@thecliniceu.com

# First admin (used by seed)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=CHANGE_ME_MIN_8_CHARS
ADMIN_NAME=Owner

# Leave empty = first signup allowed, then invite-only / closed
SIGNUP_INVITE_CODE=

# Leave unset so Admin → Payments can toggle Test payment mode
ALLOW_DEMO_PAYMENTS=

# Combined admin+storefront on one process
DEPLOYMENT_ROLE=combined

# Temporarily open; tighten to your office/VPN IP after first login
ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0

# Control plane (private server). Copy to deploy/env/control.env and fill in.

# --- Database (stays on this server) ---
POSTGRES_USER=mosmo
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=mosmo
# Loopback only by default. Set to the private/VPN IP of THIS server so the
# storefront can connect. Never 0.0.0.0.
DB_BIND_IP=127.0.0.1

# --- App ---
# Long random string: openssl rand -base64 48
AUTH_SECRET=change-me
# Private hostname for the dashboard. Not linked from any storefront.
CONTROL_DOMAIN=control.example-internal.com
# Public root domain used for store subdomains (points at the storefront box).
NEXT_PUBLIC_ROOT_DOMAIN=shops.example.com
# Public base URL customers see (storefront edge).
NEXT_PUBLIC_APP_URL=https://shops.example.com

# --- Domain automation ---
# Public IP of the storefront server — shown to merchants as the A record.
STOREFRONT_IP=203.0.113.10
# Optional CNAME target for subdomains (leave blank to always use the A record).
STOREFRONT_CNAME=

# --- Access control ---
ACME_EMAIL=ops@example.com
# Space-separated CIDRs allowed to reach the dashboard (office IP, VPN exit).
# Payment webhooks bypass this. Default below allows everyone — set it.
ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0
# Required for any account after the first one. Leave blank to keep signup closed.
SIGNUP_INVITE_CODE=

# Bootstrap admin for first seed (npm run db:seed). Required in production.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_NAME=Owner

# Test payment mode: leave unset so Admin → Payments can toggle it.
# Set to "false" only when handing to the client to lock testing off.
ALLOW_DEMO_PAYMENTS=

# --- Backups ---
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# --- Optional ---
# Product image uploads (Vercel Blob). Leave blank to disable.
BLOB_READ_WRITE_TOKEN=

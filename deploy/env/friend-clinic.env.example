# Second Clinic instance — IP-only bootstrap (no domain yet).
# Copy on the server: cp deploy/env/friend-clinic.env.example deploy/env/friend-clinic.env
#
# Replace SERVER_IP with the Hetzner public IPv4 everywhere below.

POSTGRES_USER=mosmo
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=mosmo

AUTH_SECRET=CHANGE_ME_AUTH_SECRET

# Public IP of this server
STOREFRONT_IP=SERVER_IP

# IP-as-host until DNS is connected (http only — no TLS on raw IP)
NEXT_PUBLIC_ROOT_DOMAIN=SERVER_IP
NEXT_PUBLIC_APP_URL=http://SERVER_IP
CONTROL_DOMAIN=SERVER_IP
AUTH_URL=http://SERVER_IP

# Placeholder until you have a real domain (required by Caddy config)
ACME_EMAIL=ops@example.com

ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=CHANGE_ME_MIN_8_CHARS
ADMIN_NAME=Owner

SIGNUP_INVITE_CODE=
ALLOW_DEMO_PAYMENTS=

DEPLOYMENT_ROLE=combined

# Allow browsing via http://SERVER_IP before DNS
ALLOW_IP_ACCESS=true

ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0

# Storefront edge (public server). Copy to deploy/env/storefront.env.
#
# Treat everything here as compromised the day the box is seized: no admin
# credentials, no processor keys, and a database user with limited grants.

# Control-plane database over the private tunnel (WireGuard IP or Hetzner
# private network address). Use the restricted role once payment-session
# creation has moved to the control plane; until then use the app role.
DATABASE_URL=postgresql://storefront:change-me@10.0.0.1:5432/mosmo

# Must match the control plane so sessions/tokens validate consistently.
AUTH_SECRET=change-me

NEXT_PUBLIC_ROOT_DOMAIN=shops.example.com
NEXT_PUBLIC_APP_URL=https://shops.example.com

ACME_EMAIL=ops@example.com
